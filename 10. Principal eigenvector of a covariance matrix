import numpy as np
import matplotlib.pyplot as plt

C = np.array([[5, 2],
              [2, 2]])

e, v = np.linalg.eigh(C)
i = np.argmax(e)

print("Eigenvalues:", e)
print("Eigenvectors:\n", v)
print("Principal Eigenvector:", v[:, i])

for j in range(2):
    plt.quiver(0, 0, v[0, j], v[1, j],
               angles="xy", scale_units="xy", scale=1)

plt.xlim(-1.5, 1.5)
plt.ylim(-1.5, 1.5)
plt.grid()
plt.title("Principal Direction")
plt.show()
