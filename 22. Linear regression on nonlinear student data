import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error

np.random.seed(1)
X = np.linspace(1, 10, 50).reshape(-1, 1)
y = 5 * X.ravel() ** 2 + np.random.randn(50) * 10

Xtr, Xte, ytr, yte = train_test_split(
    X, y, test_size=0.2, random_state=1)

model = LinearRegression().fit(Xtr, ytr)

print("Training MSE:", mean_squared_error(ytr, model.predict(Xtr)))
print("Testing MSE:", mean_squared_error(yte, model.predict(Xte)))

plt.scatter(Xte, yte, label="Actual")
plt.scatter(Xte, model.predict(Xte), label="Predicted")
plt.xlabel("Study Hours")
plt.ylabel("Marks")
plt.legend()
plt.show()
