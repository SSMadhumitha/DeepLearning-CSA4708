import numpy as np
import matplotlib.pyplot as plt

Y = np.array([0, 1, 0, 0])
P = np.array([0.1, 0.6, 0.2, 0.1])

CE = -np.sum(Y * np.log(P))
KL = np.sum(Y[Y > 0] * np.log(Y[Y > 0] / P[Y > 0]))

print("Cross-Entropy:", CE)
print("KL Divergence:", KL)

x = np.arange(4)
plt.bar(x - 0.2, Y, 0.4, label="Actual")
plt.bar(x + 0.2, P, 0.4, label="Predicted")
plt.xticks(x, ["Class 1", "Class 2", "Class 3", "Class 4"])
plt.legend()
plt.show()
