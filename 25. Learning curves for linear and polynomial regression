import numpy as np
import matplotlib.pyplot as plt
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import learning_curve

np.random.seed(1)
X = np.linspace(-3, 3, 60).reshape(-1, 1)
y = X.ravel() ** 2 + np.random.randn(60) * 2

for d in [1, 15]:
    model = make_pipeline(PolynomialFeatures(d), LinearRegression())
    sizes, train, val = learning_curve(
        model, X, y, cv=5,
        train_sizes=np.linspace(0.2, 1.0, 5),
        scoring="neg_mean_squared_error")

    plt.plot(sizes, -train.mean(axis=1), "o-", label=f"Degree {d} Training")
    plt.plot(sizes, -val.mean(axis=1), "s--", label=f"Degree {d} Validation")

plt.xlabel("Number of Training Samples")
plt.ylabel("Mean Squared Error")
plt.title("Learning Curves")
plt.legend()
plt.show()
