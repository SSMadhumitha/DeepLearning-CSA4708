import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.pipeline import make_pipeline

np.random.seed(1)
X = np.linspace(1, 10, 20).reshape(-1, 1)
y = 3 * X.ravel() + 2 * np.sin(X.ravel()) + np.random.randn(20) * 2

xx = np.linspace(1, 10, 200).reshape(-1, 1)
plt.scatter(X, y, label="Actual")

for d in [1, 2, 10]:
    model = make_pipeline(PolynomialFeatures(d), LinearRegression())
    model.fit(X, y)
    plt.plot(xx, model.predict(xx), label=f"Degree {d}")

plt.xlabel("House Area")
plt.ylabel("House Price")
plt.legend()
plt.title("Polynomial Regression Comparison")
plt.show()
