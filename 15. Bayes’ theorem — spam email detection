import matplotlib.pyplot as plt

prior = 0.30
p_word_spam = 0.70
p_word_ham = 0.10

posterior = (prior * p_word_spam) / (
    prior * p_word_spam + (1 - prior) * p_word_ham)

print("Probability Email Is Spam:", posterior)

plt.bar(["Prior", "Posterior"], [prior, posterior])
plt.ylabel("Probability")
plt.title("Spam Probability")
plt.show()
