import matplotlib.pyplot as plt

prior = 0.02
sensitivity = 0.95
false_positive = 0.05

posterior = (sensitivity * prior) / (
    sensitivity * prior + false_positive * (1 - prior))

print("Posterior Probability:", posterior)

plt.bar(["Prior", "Posterior"], [prior, posterior])
plt.ylabel("Probability")
plt.title("Disease Probability")
plt.show()
