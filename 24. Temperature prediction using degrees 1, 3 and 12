import numpy as np
import matplotlib.pyplot as plt
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error

np.random.seed(1)
X = np.linspace(0, 10, 50).reshape(-1, 1)
y = 20 + 3 * X.ravel() + 5 * np.sin(X.ravel()) + np.random.randn(50)
Xtr, Xte, ytr, yte = train_test_split(
    X, y, test_size=0.2, random_state=1)

xx = np.linspace(0, 10, 200).reshape(-1, 1)
plt.scatter(X, y, label="Actual")

for d in [1, 3, 12]:
    m = make_pipeline(PolynomialFeatures(d), LinearRegression())
    m.fit(Xtr, ytr)
    print(f"Degree {d} Training MSE:", mean_squared_error(ytr, m.predict(Xtr)))
    print(f"Degree {d} Testing MSE:", mean_squared_error(yte, m.predict(Xte)))
    plt.plot(xx, m.predict(xx), label=f"Degree {d}")

plt.legend()
plt.title("Temperature Model Comparison")
plt.show()
